<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Promptify" : "Promptify — AI image prompt library" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="A curated library of AI image prompts. Search, browse by category, and save your favorites.">
    <meta name="theme-color" content="#fafaf9">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Promptify">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-signed-in="<%= current_user.present? %>">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <%= link_to root_path, class: "logo", "aria-label": "Promptify home" do %>
          <span class="logo__mark" aria-hidden="true"></span>
          <span class="logo__text">Promptify</span>
        <% end %>

        <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" data-nav-toggle>
          <span class="sr-only">Toggle menu</span>
          <%= render "shared/icon", name: "menu" %>
        </button>

        <nav id="site-nav" class="site-nav" data-nav>
          <%= link_to "Browse", root_path, class: ["site-nav__link", ("is-active" if controller_name == "prompts")] %>
          <% if current_user&.member? %>
            <span class="tag tag--premium">Member</span>
          <% else %>
            <%= link_to "Go Pro", membership_path, class: ["site-nav__link", ("is-active" if controller_name.in?(%w[memberships payments]))] %>
          <% end %>
          <% if current_user %>
            <%= link_to bookmarks_path, class: ["site-nav__link", ("is-active" if controller_name == "bookmarks")] do %>
              Saved <span class="badge" data-saved-count><%= current_user.bookmarks.size %></span>
            <% end %>
            <%= button_to "Sign out", session_path, method: :delete, class: "site-nav__link site-nav__button" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "site-nav__link" %>
            <%= link_to "Sign up", new_registration_path, class: "btn btn--primary btn--sm" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% flash.each do |type, message| %>
      <div class="flash flash--<%= type %>" role="status" data-flash><%= message %></div>
    <% end %>

    <main id="main">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>Promptify · A small library of image prompts, made with Rails &amp; vanilla JS.</p>
      </div>
    </footer>

    <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
  </body>
</html>
